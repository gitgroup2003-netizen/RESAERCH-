# Copy to .env.local (local) or add in Vercel -> Project Settings -> Environment Variables.
# You only need ONE LLM key. Users can also paste their own keys in the app (they stay in the browser).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: any OpenAI-compatible endpoint (Ollama, OpenRouter, Groq, LM Studio ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Optional but recommended: live web search (Tavily has a free tier)
TAVILY_API_KEY=

# Optional: polite-pool email for OpenAlex / Crossref (better rate limits)
CONTACT_EMAIL=
